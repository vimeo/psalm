<?php

// Signature refinements for functions that already exist on earlier PHP versions but whose Psalm
// types are tightened for PHP 8.0. Unlike the classes in Php80.phpstub, these must stay version
// gated (loaded only when analysing >= 8.0): applying the stricter 8.0 parameter types on an older
// analysis version would produce false positives against the looser earlier signatures.

/**
 * @psalm-pure
 *
 * @param resource|null $context
 *
 * @return ($associative is false|0 ? list<string> : array<string, string|list<string>>)|false
 *
 * @psalm-taint-sink ssrf $url
 */
function get_headers(string $url, bool $associative = false, $context = null) : array|false {}

/**
 * @psalm-pure
 *
 * @psalm-flow ($values) -> return
 */
function pack(string $format, mixed ...$values): string {}
