/**
 * TPurity is what iterating over the attached iterators may do: `new MultipleIterator()` cannot
 * bind it, so it is impure unless declared (`MultipleIterator[pure]<int, string>`).
 *
 * @template-covariant TKey
 * @template-covariant TValue
 * @psalm-purity-template TPurity(impure)
 *
 * @template-implements Iterator[TPurity]<TKey, TValue>
 */
class MultipleIterator implements Iterator {
    const MIT_NEED_ANY = 0 ;
    const MIT_NEED_ALL = 1 ;
    const MIT_KEYS_NUMERIC = 0 ;
    const MIT_KEYS_ASSOC = 2 ;

    /**
     * @param int-mask-of<self::MIT_*> $flags
     * @psalm-pure
     */
    public function __construct (int $flags = 0) {}

    /**
     * @param Iterator[TPurity]<TKey,TValue> $iterator
     * @param string|int $infos
     * @return void
     *
     * @psalm-capabilities read-props|write-this-props
     */
    public function attachIterator(Iterator $iterator, $infos = '') {}

    /**
     * @param Iterator<TKey, TValue> $iterator
     * @return bool
     *
     * @psalm-mutation-free
     */
    public function containsIterator(Iterator $iterator) {}

    /**
     * @return int
     *
     * @psalm-mutation-free
     */
    public function countIterators() {}

    /**
     * nullable values are returned when MIT_NEED_ANY is set
     * and one of the iterators is already drained.
     * When MIT_NEED_ALL is set and one of the iterators
     * is already drained, `current()` throws
     *
     * @psalm-pure
     * @psalm-purity-from-template TPurity
     * @return array<array-key, TValue|null>
     */
    public function current() {}

    /**
     * @param Iterator<TKey,TValue> $iterator
     * @return void
     *
     * @psalm-capabilities read-props|write-this-props
     */
    public function detachIterator(Iterator $iterator) {}

    /**
     * @return int-mask-of<self::MIT_*>
     *
     * @psalm-mutation-free
     */
    public function getFlags() {}

    /**
     * @psalm-pure
     * @psalm-purity-from-template TPurity
     * @return array<array-key, TValue|null>
     */
    public function key() {}

    /**
     * @param int-mask-of<self::MIT_*> $flags
     * @return void
     *
     * @psalm-capabilities read-props|write-this-props
     */
    public function setFlags( int $flags ) {}

    /**
     * @psalm-pure
     * @psalm-purity-from-template TPurity
     * @return void
     */
    public function rewind() {}

    /**
     * @psalm-pure
     * @psalm-purity-from-template TPurity
     * @return bool
     */
    public function valid() {}

    /**
     * @psalm-pure
     * @psalm-purity-from-template TPurity
     * @return void
     */
    public function next() {}

    /**
     * @return array<array-key, mixed>
     *
     * @psalm-mutation-free
     */
    public function __debugInfo(): array {}
}

