    /**
     * @psalm-pure
     * @psalm-purity-from-template TPurity
     * @return void
     */
    public function rewind() {}

    /**
     * @return void
     *
     * @psalm-capabilities read-props|write-this-props
     */
    public function setPostfix(string $postfix ) {}

    /**
     * @param self::PREFIX_* $part
     * @param string $value
     * @return void
     *
     * @psalm-capabilities read-props|write-this-props
     */
    public function setPrefixPart(int $part , string $value ) {}

    /**
     * @psalm-pure
     * @psalm-purity-from-template TPurity
     * @return bool
     */
    public function valid() {}
}

/**
 * TPurity is what iterating over the inner iterator may do. Matching converts the values (or keys)
 * to strings: their __toString() is assumed not to have side effects.
 *
 * @template TKey
 * @template TValue
 * @template TIterator as Iterator[TPurity]<TKey, TValue>
 * @psalm-purity-template TPurity(impure)
 *
 * @template-extends FilterIterator[TPurity]<TKey, TValue, TIterator>
 */
class RegexIterator extends FilterIterator {
    const MATCH = 0 ;
    const GET_MATCH = 1 ;
    const ALL_MATCHES = 2 ;
    const SPLIT = 3 ;
    const REPLACE = 4 ;
    const USE_KEY = 1 ;

    /**
     * @param TIterator $iterator
     * @param string $regex
     * @param self::MATCH|self::GET_MATCH|self::ALL_MATCHES|self::SPLIT|self::REPLACE $mode
     * @param int-mask<self::USE_KEY> $flags
     * @param int $preg_flags
     * @psalm-flow ($iterator) -> return
     * @psalm-pure
     */
    public function __construct(Iterator $iterator, string $regex, int $mode = self::MATCH, int $flags = 0, int $preg_flags = 0) {}

    /**
     * @psalm-pure
     * @psalm-purity-from-template TPurity
     * @return bool
     */
    public function accept() {}

    /**
     * @psalm-pure
     * @psalm-purity-from-template TPurity
     * @return TValue Can return any type.
     */
    public function current() {}

    /**
     * @psalm-pure
     * @psalm-purity-from-template TPurity
     * @return TKey scalar on success, or null on failure.
     */
    public function key() {}

    /**
     * @return self::MATCH|self::GET_MATCH|self::ALL_MATCHES|self::SPLIT|self::REPLACE
     *
     * @psalm-mutation-free
     */
    public function getMode() {}

    /**
     * @param self::MATCH|self::GET_MATCH|self::ALL_MATCHES|self::SPLIT|self::REPLACE $mode
     * @return void
     *
     * @psalm-capabilities read-props|write-this-props
     */
    public function setMode(int $mode) {}

    /**
     * @return int-mask<self::USE_KEY>
     *
     * @psalm-mutation-free
     */
    public function getFlags() {}

    /**
     * @param int-mask<self::USE_KEY> $flags
     * @return void
     *
     * @psalm-capabilities read-props|write-this-props
     */
    public function setFlags(int $flags) {}

    /**
     * @return string
     *
     * @psalm-mutation-free
     */
    public function getRegex() {}

    /**
     * @return int
     *
     * @psalm-mutation-free
     */
    public function getPregFlags() {}

    /**
     * @return void
     *
     * @psalm-capabilities read-props|write-this-props
     */
    public function setPregFlags(int $pregFlags) {}
}
