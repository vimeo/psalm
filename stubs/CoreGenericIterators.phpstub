<?php

/**
 * @template-covariant TKey
 * @template-covariant TValue
 * @psalm-purity-template TPurity(impure)
 *
 * @template-extends Traversable[TPurity]<TKey, TValue>
 */
interface IteratorAggregate extends Traversable {

    /**
     * @psalm-capabilities read-props
     * @psalm-purity-from-template TPurity
     * @return Traversable[TPurity]<TKey, TValue> An instance of an object implementing Iterator or Traversable
     */
    public function getIterator();
}

/**
 * @template-covariant TKey
 * @template-covariant TValue
 * @psalm-purity-template TPurity(impure)
 *
 * @template-extends Traversable[TPurity]<TKey, TValue>
 */
interface Iterator extends Traversable {

    /**
     * @psalm-capabilities read-props
     * @psalm-purity-from-template TPurity
     * @return TValue|null returns current value or null when iterator is drained
     * @psalm-ignore-nullable-return
     */
    public function current();

    /**
     * @psalm-capabilities read-props
     * @psalm-purity-from-template TPurity
     * @return void Any returned value is ignored.
     */
    public function next();

    /**
     * @psalm-capabilities read-props
     * @psalm-purity-from-template TPurity
     * @return TKey|null current key or null when iterator is drained
     * @psalm-ignore-nullable-return
     */
    public function key();

    /**
     * @psalm-capabilities read-props
     * @psalm-purity-from-template TPurity
     * @return bool The return value will be casted to boolean and then evaluated.
     *              Returns true on success or false on failure.
     */
    public function valid();

    /**
     * @psalm-capabilities read-props
     * @psalm-purity-from-template TPurity
     * @return void Any returned value is ignored.
     */
    public function rewind();
}

/**
 * @template-covariant TKey
 * @template-covariant TValue
 * @psalm-purity-template TPurity(impure)
 *
 * @template-extends Iterator[TPurity]<TKey, TValue>
 */
interface OuterIterator extends Iterator {
    /**
     * @psalm-capabilities read-props
     * @psalm-purity-from-template TPurity
     * @return Iterator<TKey, TValue>
     */
    public function getInnerIterator();
}

/**
 * @template-covariant TKey
 * @template-covariant TValue
 * @psalm-purity-template TPurity(impure)
 *
 * @template-extends Iterator[TPurity]<TKey, TValue>
 */
interface RecursiveIterator extends Iterator {

    /**
     * @psalm-capabilities read-props
     * @psalm-purity-from-template TPurity
     * @return bool true if the current entry can be iterated over, otherwise returns false.
     */
    public function hasChildren();

    /**
     * @psalm-capabilities read-props
     * @psalm-purity-from-template TPurity
     * @return RecursiveIterator<TKey, TValue> An iterator for the current entry.
     */
    public function getChildren();
}

/**
 * @template-covariant TKey
 * @template-covariant TValue
 * @psalm-purity-template TPurity(impure)
 * @template-extends Iterator[TPurity]<TKey, TValue>
 */
interface SeekableIterator extends Iterator {
    /**
     * Seeks to a position
     * @link https://php.net/manual/en/seekableiterator.seek.php
     *
     * @param int $position The position to seek to.
     * @return void
     *
     * @since 5.1.0
     *
     * @psalm-capabilities read-props
     * @psalm-purity-from-template TPurity
     */
    public function seek($position);
}

/**
 * TPurity is what iterating over the inner iterator may do, which is all iterating over the
 * wrapper does: where it is positioned is engine state, like the position of a generator.
 *
 * @template-covariant TKey
 * @template-covariant TValue
 * @template-covariant TIterator as Traversable[TPurity]<TKey, TValue>
 * @psalm-purity-template TPurity(impure)
 *
 * @template-implements OuterIterator[TPurity]<TKey, TValue>
 *
 * @mixin TIterator
 */
class IteratorIterator implements OuterIterator {
    /**
     * Wrapping an IteratorAggregate calls its getIterator().
     *
     * @param TIterator $iterator
     * @psalm-pure
     * @psalm-purity-from-template TPurity
     * @psalm-flow ($iterator) -> return
     */
    public function __construct(Traversable $iterator, ?string $class = null) {}

    /**
     * @psalm-pure
     * @psalm-purity-from-template TPurity
     * @return Iterator[TPurity]<TKey, TValue>|null
     */
    public function getInnerIterator() {}

    /**
     * @psalm-pure
     * @psalm-purity-from-template TPurity
     * @return void
     */
    public function rewind() {}

    /**
     * @psalm-pure
     * @psalm-purity-from-template TPurity
     * @return bool
     */
    public function valid() {}

    /**
     * @psalm-pure
     * @psalm-purity-from-template TPurity
     * @return void
     */
    public function next() {}

    /**
     * @psalm-pure
     * @psalm-purity-from-template TPurity
     * @return TValue|null current value or null when iterator is drained
     * @psalm-ignore-nullable-return
     */
    public function current() {}

    /**
     * @psalm-pure
     * @psalm-purity-from-template TPurity
     * @return TKey|null current key or null when iterator is drained
     * @psalm-ignore-nullable-return
     */
    public function key() {}
}

/**
 * TPurity is what iterating over the appended iterators may do: `new AppendIterator()` cannot bind
 * it, so it is impure unless declared (`AppendIterator[pure]<int, string, Iterator[pure]<int, string>>`).
 *
 * @template TKey
 * @template TValue
 * @template TIterator as Iterator[TPurity]<TKey, TValue>
 * @psalm-purity-template TPurity(impure)
 *
 * @template-extends IteratorIterator[TPurity]<TKey, TValue, TIterator>
 */
class AppendIterator extends IteratorIterator {
    /**
     * @psalm-pure
     */
    public function __construct(){}

    /**
     * Rewinds the iterator if it is the first one appended.
     *
     * @param TIterator $iterator
     * @return void
     *
     * @psalm-capabilities read-props|write-this-props
     * @psalm-purity-from-template TPurity
     */
    public function append(Iterator $iterator) {}

    /**
     * @psalm-pure
     * @psalm-purity-from-template TPurity
     * @return void
     */
    public function rewind() {}

    /**
     * @psalm-pure
     * @psalm-purity-from-template TPurity
     * @return bool
     */
    public function valid() {}

    /**
     * @psalm-pure
     * @psalm-purity-from-template TPurity
     * @return void
     */
    public function next() {}

    /**
     * @return ArrayIterator<int, TIterator>
     *
     * @psalm-mutation-free
     */
    public function getArrayIterator() {}

    /**
     * @return int|null
     *
     * @psalm-pure
     */
    public function getIteratorIndex() {}

    /**
     * @psalm-pure
     * @psalm-purity-from-template TPurity
     * @return TValue|null current value or null when iterator is drained
     * @psalm-ignore-nullable-return
     */
    public function current() {}

    /**
     * @psalm-pure
     * @psalm-purity-from-template TPurity
     * @return TKey|null current value or null when iterator is drained
     * @psalm-ignore-nullable-return
     */
    public function key() {}
}

/**
 * TStorage is what writing the storage costs besides writing the ArrayIterator itself: nothing
 * when the storage is an array, write-props when it is an object, whose properties the mutators
 * then write. The constructor binds it from what it is given.
 *
 * @template TKey as array-key
 * @template TValue
 * @psalm-purity-template TStorage(write-props) <= write-props
 * @template-implements SeekableIterator<TKey, TValue>
 * @template-implements ArrayAccess<TKey, TValue>
 *
 * @psalm-capabilities read-props|write-this-props
 */
class ArrayIterator implements SeekableIterator, ArrayAccess, Serializable, Countable {
    const STD_PROP_LIST = 1;
    const ARRAY_AS_PROPS = 2;

    /**
     * @param array<TKey, TValue>|object $array The array or object to be iterated on.
     * @param int-mask-of<static::*> $flags Flags to control the behaviour of the ArrayObject object.
     * @psalm-flow ($array) -> return
     *
     * @return self[$array is array ? pure : write-props]<TKey, TValue>
     *
     * @psalm-pure
     */
    public function __construct($array = array(), $flags = 0) { }

    /**
     * @param TKey $offset The offset being checked.
     * @return bool true if the offset exists, otherwise false
     *
     * @psalm-mutation-free
     */
    public function offsetExists($offset) { }

    /**
     * @param TKey $offset The offset to get the value from.
     * @return TValue|null The value at offset index, null when accessing invalid indexes
     * @psalm-ignore-nullable-return
     *
     * @psalm-mutation-free
     */
    public function offsetGet($offset) { }

    /**
     * @param TKey $offset The index to set for.
     * @param TValue $value The new value to store at the index.
     * @return void
     *
     * @psalm-capabilities read-props|write-this-props
     * @psalm-purity-from-template TStorage
     */
    public function offsetSet($offset, $value) { }

    /**
     * @param TKey $offset The offset to unset.
     * @return void
     *
     * @psalm-capabilities read-props|write-this-props
     * @psalm-purity-from-template TStorage
     */
    public function offsetUnset($offset) { }

    /**
     * @param TValue $value The value to append.
     * @return void
     *
     * @psalm-capabilities read-props|write-this-props
     * @psalm-purity-from-template TStorage
     */
    public function append($value) { }

    /**
     * @return array<TKey, TValue> A copy of the array, or array of public properties
     *                             if ArrayIterator refers to an object.
     *
     * @psalm-mutation-free
     */
    public function getArrayCopy() { }

    /**
     * @return int The number of elements or public properties in the associated
     *             array or object, respectively.
     *
     * @psalm-mutation-free
     */
    public function count() { }

    /**
     * @return int-mask-of<self::*> The current flags.
     *
     * @psalm-mutation-free
     */
    public function getFlags() { }

    /**
     * @param int-mask-of<self::*> $flags bitmask
     * @return void
     *
     * @psalm-capabilities read-props|write-this-props
     */
    public function setFlags($flags) { }

    /**
     * @return void
     *
     * @psalm-capabilities read-props|write-this-props
     * @psalm-purity-from-template TStorage
     */
    public function asort() { }

    /**
     * @return void
     *
     * @psalm-capabilities read-props|write-this-props
     * @psalm-purity-from-template TStorage
     */
    public function ksort() { }

    /**
     * @psalm-purity-template P
     * @param callable[P](TValue,TValue):int $cmp_function The compare function used for the sort.
     * @return void
     *
     * @psalm-capabilities read-props|write-this-props
     * @psalm-purity-from-template P, TStorage
     */
    public function uasort($cmp_function) { }

    /**
     * @psalm-purity-template P
     * @param callable[P](TKey,TKey):int $cmp_function The compare function used for the sort.
     * @return void
     *
     * @psalm-capabilities read-props|write-this-props
     * @psalm-purity-from-template P, TStorage
     */
    public function uksort($cmp_function) { }

    /**
     * @return void
     *
     * @psalm-capabilities read-props|write-this-props
     * @psalm-purity-from-template TStorage
     */
    public function natsort() { }

    /**
     * @return void
     *
     * @psalm-capabilities read-props|write-this-props
     * @psalm-purity-from-template TStorage
     */
    public function natcasesort() { }

    /**
     * @param string $serialized The serialized ArrayIterator object to be unserialized.
     * @return void
     *
     * @psalm-impure
     */
    public function unserialize($serialized) { }

    /**
     * @return string The serialized ArrayIterator
     *
     * @psalm-impure
     */
    public function serialize() { }

    /**
     * @return void
     *
     * @psalm-capabilities read-props|write-this-props
     */
    public function rewind() { }

    /**
     * @return TValue|null current value or null when iterator is drained
     * @psalm-ignore-nullable-return
     *
     * @psalm-mutation-free
     */
    public function current() { }

    /**
     * @return TKey|null The current array key or null when iterator is drained
     * @psalm-ignore-nullable-return
     *
     * @psalm-mutation-free
     */
    public function key() { }

    /**
     * @return void
     *
     * @psalm-capabilities read-props|write-this-props
     */
    public function next() { }

    /**
     * @return bool
     *
     * @psalm-mutation-free
     */
    public function valid() { }

    /**
     * @param int $position The position to seek to.
     * @return void
     *
     * @psalm-capabilities read-props|write-this-props
     */
    public function seek($position) { }

    /**
     * @return array<array-key, mixed>
     *
     * @psalm-mutation-free
     */
    public function __serialize(): array {}

    /**
     * @param array<array-key, mixed> $data
     *
     * @psalm-capabilities read-props|write-this-props
     */
    public function __unserialize(array $data): void {}

    /**
     * @return array<array-key, mixed>
     *
     * @psalm-mutation-free
     */
    public function __debugInfo(): array {}
}

/**
 * Iterating calls accept(): a subclass binding TPurity (`@extends FilterIterator[pure]<...>`) must
 * accept within it, and one that binds nothing may accept however it likes, as TPurity is then
 * impure.
 *
 * @template-covariant TKey
 * @template-covariant TValue
 * @template-covariant TIterator as Traversable[TPurity]<TKey, TValue>
 * @psalm-purity-template TPurity(impure)
 *
 * @template-extends IteratorIterator[TPurity]<TKey, TValue, TIterator>
 */
abstract class FilterIterator extends IteratorIterator {
    /**
     * @param TIterator $iterator
     * @psalm-pure
     * @psalm-flow ($iterator) -> return
     */
    public function __construct(Iterator $iterator) {}

    /**
     * @psalm-capabilities read-props
     * @psalm-purity-from-template TPurity
     * @return bool
     */
    abstract public function accept();

    /**
     * @psalm-pure
     * @psalm-purity-from-template TPurity
     * @return void
     */
    public function rewind() {}

    /**
     * @psalm-pure
     * @psalm-purity-from-template TPurity
     * @return void
     */
    public function next() {}

    /**
     * @psalm-pure
     * @psalm-purity-from-template TPurity
     * @return TValue Can return any type.
     */
    public function current() {}

    /**
     * @psalm-pure
     * @psalm-purity-from-template TPurity
     * @return TKey scalar on success, or null on failure.
     */
    public function key() {}
}

/**
 * TPurity is what iterating over the inner iterator may do. With CALL_TOSTRING (the default),
 * moving also converts the current value to a string: its __toString() is assumed not to have
 * side effects.
 *
 * @template-covariant TKey
 * @template-covariant TValue
 * @template-covariant TIterator as Iterator[TPurity]<TKey, TValue>
 * @psalm-purity-template TPurity(impure)
 *
 * @template-implements OuterIterator[TPurity]<TKey, TValue>
 * @template-implements ArrayAccess<TKey, TValue>
 *
 * @template-extends IteratorIterator[TPurity]<TKey, TValue, TIterator>
 */
class CachingIterator extends IteratorIterator implements OuterIterator , ArrayAccess , Countable  {
    const CALL_TOSTRING = 1 ;
    const CATCH_GET_CHILD = 16 ;
    const TOSTRING_USE_KEY = 2 ;
    const TOSTRING_USE_CURRENT = 4 ;
    const TOSTRING_USE_INNER = 8 ;
    const FULL_CACHE = 256 ;

    /**
     * @param TIterator $iterator
     * @param int-mask-of<self::*> $flags
     * @psalm-flow ($iterator) -> return
     * @psalm-pure
     */
    public function __construct(Iterator $iterator, int $flags = self::CALL_TOSTRING) {}

    /**
     * @psalm-pure
     * @psalm-purity-from-template TPurity
     * @return void
     */
    public function rewind() {}

    /**
     * @psalm-pure
     * @psalm-purity-from-template TPurity
     * @return bool
     */
    public function valid() {}

    /**
     * @psalm-pure
     * @psalm-purity-from-template TPurity
     * @return void
     */
    public function next() {}

    /**
     * @psalm-pure
     * @psalm-purity-from-template TPurity
     * @return bool
     */
    public function hasNext () {}

    /**
     * @psalm-pure
     * @psalm-purity-from-template TPurity
     * @return TValue|null current value or null when iterator is drained
     * @psalm-ignore-nullable-return
     */
    public function current() {}

    /**
     * @psalm-pure
     * @psalm-purity-from-template TPurity
     * @return TKey|null current key or null when iterator is drained
     * @psalm-ignore-nullable-return
     */
    public function key() {}

    /**
     * With TOSTRING_USE_INNER, converts the inner iterator to a string.
     *
     * @psalm-pure
     * @psalm-purity-from-template TPurity
     */
    public function __toString(): string {}

    /**
     * @return int-mask-of<self::*>
     *
     * @psalm-mutation-free
     */
    public function getFlags() {}

    /**
     * @param int-mask-of<self::*> $flags
     * @return void
     *
     * @psalm-capabilities read-props|write-this-props
     */
    public function setFlags(int $flags) {}

    /**
     * @param TKey $key
     * @return TValue
     *
     * @psalm-mutation-free
     */
    public function offsetGet($key) {}

    /**
     * @param TKey $key
     * @param TValue $value
     * @return void
     *
     * @psalm-capabilities read-props|write-this-props
     */
    public function offsetSet($key, mixed $value) {}

    /**
     * @param TKey $key
     * @return void
     *
     * @psalm-capabilities read-props|write-this-props
     */
    public function offsetUnset($key) {}

    /**
     * @param TKey $key
     * @return bool
     *
     * @psalm-mutation-free
     */
    public function offsetExists($key) {}

    /**
     * @return array<array-key, TValue>
     *
     * @psalm-mutation-free
     */
    public function getCache() {}

    /**
     * @return int
     *
     * @psalm-mutation-free
     */
    public function count() {}
}

/**
 * TPurity is what iterating over the inner iterator and calling the callback may do.
 *
 * @template-covariant TKey
 * @template-covariant TValue
 * @template-covariant TIterator as Iterator[TPurity]<TKey, TValue>
 * @psalm-purity-template TPurity(impure)
 *
 * @template-implements OuterIterator[TPurity]<TKey, TValue>
 *
 * @template-extends FilterIterator[TPurity]<TKey, TValue, TIterator>
 */
class CallbackFilterIterator extends FilterIterator implements OuterIterator  {
    /**
     * @param TIterator $iterator
     * @param callable[TPurity](TValue, TKey, TIterator): bool $callback
     * @psalm-pure
     * @psalm-flow ($iterator) -> return
     */
    public function __construct(Iterator $iterator, callable $callback) {}

    /**
     * @psalm-pure
     * @psalm-purity-from-template TPurity
     * @return bool
     */
    public function accept() {}

    /**
     * @psalm-pure
     * @psalm-purity-from-template TPurity
     * @return TValue|null current value or null when iterator is drained
     * @psalm-ignore-nullable-return
     */
    public function current() {}

    /**
     * @psalm-pure
     * @psalm-purity-from-template TPurity
     * @return TKey|null current key or null when iterator is drained
     * @psalm-ignore-nullable-return
     */
    public function key() {}
}

/**
 * @template-implements SeekableIterator<int, DirectoryIterator>
 */
class DirectoryIterator extends SplFileInfo implements SeekableIterator {

    /**
     * @psalm-capabilities io
     */
    public function __construct(string $path){}

    /**
     * @return self
     *
     * @psalm-mutation-free
     */
    public function current() {}
    /**
     * @return int|false
     * @psalm-ignore-falsable-return
     *
     * @psalm-mutation-free
     */
    public function key() {}

    /**
     * @return void
     *
     * @psalm-capabilities read-props|write-this-props|io
     */
    public function next(){}
    /**
     * @return void
     *
     * @psalm-capabilities read-props|write-this-props|io
     */
    public function rewind(){}

    /**
     * @param int $position
     *
     * @psalm-capabilities read-props|write-this-props|io
     */
    public function seek($position) {}

    /**
     * @return bool
     *
     * @psalm-mutation-free
     */
    public function valid(){}

    /**
     * @psalm-mutation-free
     */
    public function getFilename() {}

    /**
     * @psalm-mutation-free
     */
    public function getExtension() {}

    /**
     * @psalm-mutation-free
     */
    public function getBasename(string $suffix = "") {}

    /**
     * @psalm-mutation-free
     */
    public function isDot() {}

    /**
     * @psalm-mutation-free
     */
    public function __toString() {}
}

/**
 * @template-implements Iterator[pure]<never, never>
 */
class EmptyIterator implements Iterator {
    /**
     * @return never
     * @psalm-pure
     */
    public function current() {}
    /**
     * @return never
     * @psalm-pure
     */
    public function key() {}
    /**
     * @return void
     * @psalm-pure
     */
    public function next() {}
    /**
     * @return void
     * @psalm-pure
     */
    public function rewind() {}

    /**
     * @return false
     * @psalm-pure
     */
    public function valid() {}
}

/**
 * @template-extends DirectoryIterator<string, FilesystemIterator|SplFileInfo|string>
 */
class FilesystemIterator extends DirectoryIterator
{
    const CURRENT_AS_PATHNAME = 32;
    const CURRENT_AS_FILEINFO = 0;
    const CURRENT_AS_SELF = 16;
    const CURRENT_MODE_MASK = 240;
    const KEY_AS_PATHNAME = 0;
    const KEY_AS_FILENAME = 256;
    const FOLLOW_SYMLINKS = 512;
    const KEY_MODE_MASK = 3840;
    const NEW_CURRENT_AND_KEY = 256;
    const SKIP_DOTS = 4096;
    const UNIX_PATHS = 8192;

    /**
     * @param int-mask<self::CURRENT_AS_PATHNAME,self::CURRENT_AS_FILEINFO,self::CURRENT_AS_SELF,self::KEY_AS_PATHNAME,self::KEY_AS_FILENAME,self::FOLLOW_SYMLINKS,self::NEW_CURRENT_AND_KEY,self::SKIP_DOTS,self::UNIX_PATHS> $flags
     *
     * @psalm-capabilities io
     */
    public function __construct(string $path, int $flags = self::KEY_AS_PATHNAME|self::CURRENT_AS_FILEINFO|self::SKIP_DOTS) {}

    /**
     * @return FilesystemIterator|SplFileInfo|string|null
     * @psalm-ignore-nullable-return
     *
     * @psalm-mutation-free
     */
    public function current() {}
    /**
     * @return int-mask<self::CURRENT_AS_PATHNAME,self::CURRENT_AS_FILEINFO,self::CURRENT_AS_SELF,self::KEY_AS_PATHNAME,self::KEY_AS_FILENAME,self::FOLLOW_SYMLINKS,self::NEW_CURRENT_AND_KEY,self::SKIP_DOTS,self::UNIX_PATH>
     *
     * @psalm-mutation-free
     */
    public function getFlags() {}

    /**
     * @param int-mask<self::CURRENT_AS_PATHNAME,self::CURRENT_AS_FILEINFO,self::CURRENT_AS_SELF,self::KEY_AS_PATHNAME,self::KEY_AS_FILENAME,self::FOLLOW_SYMLINKS,self::NEW_CURRENT_AND_KEY,self::SKIP_DOTS,self::UNIX_PATH> $flags
     * @return void
     *
     * @psalm-capabilities read-props|write-this-props
     */
    public function setFlags($flags) {}
    /**
     * @return string|null
     * @psalm-ignore-nullable-return
     *
     * @psalm-mutation-free
     */
    public function key() {}

    /**
     * @return void
     *
     * @psalm-capabilities read-props|write-this-props|io
     */
    public function rewind() {}
}



/**
