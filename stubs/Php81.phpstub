<?php

// Reopens of pre-existing classes to refine their types / add PHP 8.1 methods. These stay version
// gated (loaded only when analysing >= 8.1). Genuinely-new 8.1 classes (enums, reflection-enum
// classes, ReflectionIntersectionType, the resource->object classes, ...) live in
// PhpVersionedClasses.phpstub (always loaded, `@since` tagged).

namespace {
    class ReflectionClass implements Reflector {
        /** @psalm-pure */
        public function isEnum(): bool {}
    }

    class ReflectionProperty implements Reflector
    {
        /**
         * @deprecated Starting from PHP 8.1, this method is pure, and has no effect.
         *
         * @psalm-pure
         */
        public function setAccessible(bool $accessible): void {}
    }

    class ReflectionMethod extends ReflectionFunctionAbstract
    {
        /**
         * @deprecated Starting from PHP 8.1, this method is pure, and has no effect.
         *
         * @psalm-pure
         */
        public function setAccessible(bool $accessible): void {}
    }
}
