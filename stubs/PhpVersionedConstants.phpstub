<?php

// Global constants introduced by a specific PHP version. Unlike the version-specific stubs
// (Php80.phpstub, ...), which refine pre-existing symbols and must stay gated to the analysis
// version, these are brand-new symbols, so this file is loaded on every analysis version (a runtime
// that already defines a constant must not hide it). Each carries an `@since x.y` tag, so a use is
// reported as undefined when analysing an older PHP version without a guard or a polyfill.
//
// Only top-level `const` is read for `@since` (not `define()`), outside any namespace block.
// Constants whose value depends on the platform or on the library version PHP is built against
// carry a `@var` type instead of a literal, with a placeholder value.

// Core

/**
 * @var string
 * @since 8.5
 */
const PHP_BUILD_DATE = '';

/**
 * @var string
 * @since 8.5
 */
const PHP_BUILD_PROVIDER = '';

/**
 * @var string
 * @since 8.5
 */
