<?php

// The taints webmozart/assert 2 passes along: an assertion returns the value it is given (`@psalm-flow ($value) ->
// return`), as do its nullOr*, all* and allNullOr* variants, and the assertions that aren't pure (e.g. those reading
// the file system or looking up classes) are specialized per call (`@psalm-taint-specialize`), so that the taints of
// one call's value don't reach the result of another. Loaded when the analysed code uses the package,
// refining its classes (see Config::visitStubFiles()): the methods keep the signatures and docblocks of
// webmozart/assert 2.4.

namespace Webmozart\Assert {
use ArrayAccess;
use Closure;
use Countable;
use DateTime;
use DateTimeImmutable;
use ReflectionFunction;
use ReflectionProperty;
use Throwable;
use Traversable;

/**
 * @since  1.0
 *
 * @author Bernhard Schussek <bschussek@gmail.com>
 */
