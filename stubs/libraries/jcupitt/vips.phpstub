<?php

// The taints jcupitt/vips passes along: the files images, sources and targets are read from and written to are file
// sinks. Loaded
// when the analysed code uses the package, refining its classes (see Config::visitStubFiles()).

namespace Jcupitt\Vips {
/**
 * @category  Images
 * @package   Jcupitt\Vips
 * @author    John Cupitt <jcupitt@gmail.com>
 * @copyright 2016 John Cupitt
 * @license   https://opensource.org/licenses/MIT MIT
 * @link      https://github.com/jcupitt/php-vips
 */
class Image extends ImageAutodoc implements \ArrayAccess
{
    /**
     * Find the name of the load operation vips will use to load a file, for
     * example "VipsForeignLoadJpegFile". You can use this to work out what
     * options to pass to newFromFile().
     *
     * @param string $filename The file to test.
     *
     * @return string|null The name of the load operation, or null.
     *
     * @psalm-taint-sink file $filename
     */
    public static function findLoad(string $filename): ?string
    {
    }

    /**
     * @param string $name The file to open.
     * @param array  $options  Any options to pass on to the load operation.
     *
     * @throws Exception
     *
     * @return Image A new Image.
     *
     * @psalm-taint-sink file $name
     */
    public static function newFromFile(
        string $name,
        array $options = []
    ): Image
    {
    }

    /**
     * @param string $name The file to write the image to.
     * @param array  $options  Any options to pass on to the selected save
     *     operation.
     *
     * @throws Exception
     *
     * @return void
     *
     * @psalm-taint-sink file $name
     */
    public function writeToFile(string $name, array $options = []): void
    {
    }
}
}

namespace Jcupitt\Vips {
class Source extends Connection
{
    /**
     * Make a new source from a filename. For example:
     *
     * ```php
     * $source = Source::newFromFile("myfile.jpg");
     * ```
     *
     * You can pass this source to (for example) @see Image::newFromSource()
     * @throws Exception
     *
     * @psalm-taint-sink file $filename
     */
    public static function newFromFile(string $filename): self
    {
    }
}
}

namespace Jcupitt\Vips {
class Target extends Connection
{
    /**
     * Make a new target to write to a filename. For example:
     *
     * ```php
     * $target = Target::newToFile("myfile.jpg");
     * ```
     *
     * You can pass this target to (for example) @see Image::writeToTarget()
     * @throws Exception
     *
     * @psalm-taint-sink file $filename
     */
    public static function newToFile(string $filename): self
    {
    }
}
}
