<?php

// What psr/http-message holds is input: a message, and everything read from it, comes from a client or a server, or
// from a framework that built it from them. Loaded when the analysed code uses the package, refining its interfaces
// (see Config::visitStubFiles()). The parameters are typed as in version 2, and the returns as in version 1, so that
// implementations of either still match.

namespace Psr\Http\Message
{
    interface MessageInterface
    {
        /**
         * @return string
         *
         * @psalm-taint-source input
         */
        public function getProtocolVersion();

        /**
         * @return string[][]
         *
         * @psalm-taint-source input
         */
        public function getHeaders();

        /**
         * @return string[]
         *
         * @psalm-taint-source input
         */
        public function getHeader(string $name);

        /**
         * @return string
         *
         * @psalm-taint-source input
         */
        public function getHeaderLine(string $name);

        /**
         * @return StreamInterface
         *
         * @psalm-taint-source input
         */
        public function getBody();
    }

    interface RequestInterface extends MessageInterface
    {
        /**
         * @return string
         *
         * @psalm-taint-source input
         */
        public function getRequestTarget();

        /**
         * @return string
         *
         * @psalm-taint-source input
         */
        public function getMethod();

        /**
         * @return UriInterface
         *
         * @psalm-taint-source input
         */
        public function getUri();
    }

    interface ServerRequestInterface extends RequestInterface
    {
        /**
         * The entries the client sends are sources, as those of $_SERVER (see ServerVariableTaints)
         *
         * @return array
         */
        public function getServerParams();

        /**
         * @return array
         *
         * @psalm-taint-source input
         */
        public function getCookieParams();

        /**
         * @return array
         *
         * @psalm-taint-source input
         */
        public function getQueryParams();

        /**
         * @return array
         *
         * @psalm-taint-source input
         */
        public function getUploadedFiles();

        /**
         * @return null|array|object
         *
         * @psalm-taint-source input
         */
        public function getParsedBody();

        /**
         * @return array
         *
         * @psalm-taint-source input
         */
        public function getAttributes();

        /**
         * @return mixed
         *
         * @psalm-taint-source input
         */
        public function getAttribute(string $name, $default = null);
    }

    interface ResponseInterface extends MessageInterface
    {
        /**
         * @return string
         *
         * @psalm-taint-source input
         */
        public function getReasonPhrase();
    }

    interface StreamInterface
    {
        /**
         * @return string
         *
         * @psalm-taint-source input
         */
        public function __toString();

        /**
         * @return string
         *
         * @throws \RuntimeException if an error occurs.
         *
         * @psalm-taint-source input
         */
        public function read(int $length);

        /**
         * @return string
         *
         * @throws \RuntimeException if unable to read or an error occurs while reading.
         *
         * @psalm-taint-source input
         */
        public function getContents();
    }

    interface UriInterface
    {
        /**
         * @return string
         *
         * @psalm-taint-source input
         */
        public function getScheme();

        /**
         * @return string
         *
         * @psalm-taint-source input
         */
        public function getAuthority();

        /**
         * @return string
         *
         * @psalm-taint-source input
         */
        public function getUserInfo();

        /**
         * @return string
         *
         * @psalm-taint-source input
         */
        public function getHost();

        /**
         * @return string
         *
         * @psalm-taint-source input
         */
        public function getPath();

        /**
         * @return string
         *
         * @psalm-taint-source input
         */
        public function getQuery();

        /**
         * @return string
         *
         * @psalm-taint-source input
         */
        public function getFragment();

        /**
         * @return string
         *
         * @psalm-taint-source input
         */
        public function __toString();
    }

    interface UploadedFileInterface
    {
        /**
         * @return StreamInterface
         *
         * @throws \RuntimeException in cases when no stream is available or can be created.
         *
         * @psalm-taint-source input
         */
        public function getStream();

        /**
         * @return string|null
         *
         * @psalm-taint-source input
         */
        public function getClientFilename();

        /**
         * @return string|null
         *
         * @psalm-taint-source input
         */
        public function getClientMediaType();
    }
}
