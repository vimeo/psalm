}

namespace Uri\WhatWg {
    /** @since 8.5 */
    class InvalidUrlException extends \Uri\InvalidUriException
    {
        /**
         * @var list<UrlValidationError>
         * @readonly
         */
        public array $errors;

        /**
         * @psalm-pure
         * @param list<UrlValidationError> $errors
         */
        public function __construct(
            string $message = "",
            array $errors = [],
            int $code = 0,
            ?\Throwable $previous = null
        ) {}
    }

    /**
     * @psalm-immutable
     * @since 8.5
     */
    final class UrlValidationError
    {
        public string $context;

        public UrlValidationErrorType $type;

        public bool $failure;

        public function __construct(string $context, UrlValidationErrorType $type, bool $failure) {}
    }

    /**
     * @psalm-immutable
     * @since 8.5
     */
    final class Url
    {
        /**
         * @psalm-pure
         * @psalm-capabilities write-refs
         * @param-out list<UrlValidationError> $errors
         */
        public static function parse(string $uri, ?Url $baseUrl = null, &$errors = null): ?Url {}

        /**
         * @psalm-capabilities write-refs
         * @param-out list<UrlValidationError> $softErrors
         * @throws InvalidUrlException
         */
        public function __construct(string $uri, ?Url $baseUrl = null, &$softErrors = null) {}

        public function getScheme(): string {}

        public function withScheme(string $scheme): Url {}

        public function getUsername(): ?string {}

        public function withUsername(?string $username): Url {}

        public function getPassword(): ?string {}

        public function withPassword(#[\SensitiveParameter] ?string $password): Url {}

        public function getAsciiHost(): ?string {}

        public function getUnicodeHost(): ?string {}

        public function withHost(?string $host): Url {}

        public function getPort(): ?int {}

        public function withPort(?int $port): Url {}

        public function getPath(): string {}

        public function withPath(string $path): Url {}

        public function getQuery(): ?string {}

        public function withQuery(?string $query): Url {}

        public function getFragment(): ?string {}

        public function withFragment(?string $fragment): Url {}

        public function equals(
            Url $url,
            \Uri\UriComparisonMode $comparisonMode = \Uri\UriComparisonMode::ExcludeFragment
        ): bool {}

        public function toAsciiString(): string {}

        public function toUnicodeString(): string {}

        /**
         * @psalm-capabilities read-props|write-refs
         * @param-out list<UrlValidationError> $softErrors
         */
        public function resolve(string $uri, &$softErrors = null): Url {}

        public function getHostType(): ?UrlHostType {}

        public function __serialize(): array {}

        public function __unserialize(array $data): void {}

        public function __debugInfo(): array {}
    }
}

