<?php

// Genuinely-new classes introduced by a specific PHP version. Unlike the version-specific stubs
// (Php80.phpstub, ...), which reopen pre-existing classes to refine their types and must stay
// gated to the analysis version, these declare brand-new symbols and are loaded on every analysis
// version so they are known to analysis. Each carries an `@since x.y` tag, so a use is reported as
// undefined (see NativeSymbolAvailabilityAnalyzer) when analysing an older PHP version without a
// polyfill, rather than being silently unknown or treated as a genuine user symbol.

namespace {
    /** @since 8.0 */
    interface Stringable
    {
        /** @return string */
        function __toString();
    }

    /**
     * @template TClass as object
     *
     * @since 8.0
     */
    class ReflectionAttribute
    {
        const IS_INSTANCEOF = 2;

        private function __construct()
        {
        }

        /**
         * @return non-empty-string
         *
         * @psalm-pure
         */
        public function getName() : string
        {
        }

        /**
         * @psalm-pure
         * @return Attribute::TARGET_*
         */
        public function getTarget() : int
        {
        }

        /** @psalm-pure */
        public function isRepeated() : bool
        {
        }

        public function getArguments() : array
        {
        }

        /**
         * @return TClass
         */
        public function newInstance() : object
        {
        }

        /**
         * @return never-return
         */
        private function __clone()
        {
        }
    }

    /**
     * @psalm-immutable
     * @since 8.0
     */
    class ReflectionUnionType extends ReflectionType {
        /** @return non-empty-list<ReflectionNamedType> */
        public function getTypes(): array {}
    }

    /** @since 8.0 */
    class UnhandledMatchError extends Error {}

    /** @since 8.0 */
    final class CurlHandle
    {
        private function __construct()
        {
        }
    }

    /** @since 8.0 */
    final class CurlMultiHandle
    {
        private function __construct()
        {
        }
    }

    /** @since 8.0 */
    final class CurlShareHandle
    {
        private function __construct()
        {
        }
    }

    /** @since 8.1 */
    interface UnitEnum {
        /** @var non-empty-string $name */
        public readonly string $name;

        /**
         * @psalm-pure
         * @return list<static>
         */
        public static function cases(): array;
    }

    /** @since 8.1 */
    interface BackedEnum extends UnitEnum
    {
        /** @var non-empty-string $name */
        public readonly string $name;
        public readonly int|string $value;

        /**
         * @psalm-pure
         */
        public static function from(string|int $value): static;

        /**
         * @psalm-pure
         */
        public static function tryFrom(string|int $value): ?static;

        /**
         * @psalm-pure
         * @return list<static>
         */
        public static function cases(): array;
    }

    /**
     * @psalm-immutable
     * @since 8.1
     */
    class ReflectionEnum extends ReflectionClass implements Reflector
    {
        public function getBackingType(): ?ReflectionType;
        public function getCase(string $name): ReflectionEnumUnitCase;
        /** @return list<ReflectionEnumUnitCase> */
        public function getCases(): array;
        public function hasCase(string $name): bool;
        public function isBacked(): bool;
    }

    /**
     * @psalm-immutable
     * @since 8.1
     */
    class ReflectionEnumUnitCase extends ReflectionClassConstant implements Reflector
    {
        public function getEnum(): ReflectionEnum;
        public function getValue(): UnitEnum;
    }

    /**
     * @psalm-immutable
     * @since 8.1
     */
    class ReflectionEnumBackedCase extends ReflectionEnumUnitCase implements Reflector
    {
        public function getBackingValue(): int|string;
    }

    /**
     * @psalm-immutable
     * @since 8.1
     */
    class ReflectionIntersectionType extends ReflectionType {
        /** @return non-empty-list<ReflectionNamedType> */
        public function getTypes(): array {}

        /** @return false */
        public function allowsNull(): bool {}
    }

    /**
     * @psalm-immutable
     * @template TValue
     *
     * @since 8.2
     */
    final class SensitiveParameterValue
    {
        /** @param TValue $value */
        public function __construct(private readonly mixed $value) {}

        /** @return array<never, never> */
        public function __debugInfo(): array {}

        /** @return TValue */
        public function getValue(): mixed {}
    }

    /**
     * Indicates that the return value of a function should not be ignored.
     * When applied to a function or method, a warning is emitted if the
     * return value is not used.
     *
     * @psalm-immutable
     * @since 8.5
     */
    #[\Attribute(\Attribute::TARGET_METHOD | \Attribute::TARGET_FUNCTION)]
    final class NoDiscard
    {
        public readonly ?string $message;

        public function __construct(?string $message = null) {}
    }

    /**
     * Persistent cURL share handle resource.
     *
     * @since 8.5
     */
    final class CurlSharePersistentHandle
    {
    }
}

namespace FTP {
    /** @since 8.1 */
    final class Connection {}
}

namespace IMAP {
    /** @since 8.1 */
    final class Connection {}
}

namespace LDAP {
    /** @since 8.1 */
    final class Connection {}
    /** @since 8.1 */
    final class Result {}
    /** @since 8.1 */
    final class ResultEntry {}
}

namespace PgSql {
    /** @since 8.1 */
    final class Connection {}
    /** @since 8.1 */
    final class Result {}
    /** @since 8.1 */
    final class Lob {}
}

namespace PSpell {
    /** @since 8.1 */
    final class Config {}
    /** @since 8.1 */
    final class Dictionary {}
}
