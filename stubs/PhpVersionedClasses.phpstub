<?php

// Genuinely-new classes introduced by a specific PHP version. Unlike the version-specific stubs
// (Php80.phpstub, ...), which reopen pre-existing classes to refine their types and must stay
// gated to the analysis version, these declare brand-new symbols and are loaded on every analysis
// version so they are known to analysis. Each carries an `@since x.y` tag, so a use is reported as
// undefined when analysing an older PHP version without a polyfill, rather than being silently
// unknown or treated as a genuine user symbol.
//
// Being loaded on every version, this file is also parsed with the grammar of older analysis
// versions, so it must not use syntax newer than PHP 7.4 that changes how a declaration parses:
// `readonly` in particular is spelled `@readonly` (immutable classes are readonly already).

namespace {
    /** @since 8.0 */
    interface Stringable
    {
        /** @return string */
        function __toString();
    }

    /**
     * @template TClass as object
     *
     * @since 8.0
     */
    class ReflectionAttribute
    {
        const IS_INSTANCEOF = 2;

        private function __construct()
        {
        }

        /**
         * @return non-empty-string
         *
         * @psalm-pure
         */
        public function getName() : string
        {
        }

        /**
         * @psalm-pure
         * @return Attribute::TARGET_*
         */
        public function getTarget() : int
        {
        }

        /** @psalm-pure */
        public function isRepeated() : bool
        {
        }

        public function getArguments() : array
        {
        }

        /**
         * @return TClass
         */
        public function newInstance() : object
        {
        }

        /**
         * @return never-return
         */
        private function __clone()
        {
        }
    }

    /**
     * @psalm-immutable
     * @since 8.0
     */
    class ReflectionUnionType extends ReflectionType {
        /** @return non-empty-list<ReflectionNamedType> */
        public function getTypes(): array {}
    }

    /** @since 8.0 */
    class UnhandledMatchError extends Error {}

    /** @since 8.0 */
    final class CurlHandle
    {
        private function __construct()
        {
        }
    }

    /** @since 8.0 */
    final class CurlMultiHandle
    {
        private function __construct()
        {
        }
    }

    /** @since 8.0 */
    final class CurlShareHandle
    {
        private function __construct()
        {
        }
    }

    /** @since 8.1 */
    interface UnitEnum {
        /**
         * @var non-empty-string $name
         * @readonly
         */
        public string $name;

        /**
         * @psalm-pure
         * @return list<static>
         */
        public static function cases(): array;
    }

    /** @since 8.1 */
    interface BackedEnum extends UnitEnum
    {
        /**
         * @var non-empty-string $name
         * @readonly
         */
        public string $name;
        /** @readonly */
        public int|string $value;

        /**
         * @psalm-pure
         */
        public static function from(string|int $value): static;

        /**
         * @psalm-pure
         */
        public static function tryFrom(string|int $value): ?static;

        /**
         * @psalm-pure
         * @return list<static>
         */
        public static function cases(): array;
    }

    /**
     * @psalm-immutable
     * @since 8.1
     */
    class ReflectionEnum extends ReflectionClass implements Reflector
    {
        public function getBackingType(): ?ReflectionType;
        public function getCase(string $name): ReflectionEnumUnitCase;
        /** @return list<ReflectionEnumUnitCase> */
        public function getCases(): array;
        public function hasCase(string $name): bool;
        public function isBacked(): bool;
    }

    /**
     * @psalm-immutable
     * @since 8.1
     */
    class ReflectionEnumUnitCase extends ReflectionClassConstant implements Reflector
    {
        public function getEnum(): ReflectionEnum;
        public function getValue(): UnitEnum;
    }

    /**
     * @psalm-immutable
     * @since 8.1
     */
    class ReflectionEnumBackedCase extends ReflectionEnumUnitCase implements Reflector
    {
        public function getBackingValue(): int|string;
    }

    /**
     * @psalm-immutable
     * @since 8.1
     */
    class ReflectionIntersectionType extends ReflectionType {
        /** @return non-empty-list<ReflectionNamedType> */
        public function getTypes(): array {}

        /** @return false */
        public function allowsNull(): bool {}
    }

    /**
     * TPurity is what running the fiber's callback may do: starting or resuming the fiber runs it
     * until it suspends or returns, so it costs what the callback costs and nothing else. Like the
     * position of a generator, where a fiber is suspended is engine state, not an effect.
     *
     * @psalm-purity-template TPurity(impure)
     *
     * @since 8.1
     */
    final class Fiber
    {
        /**
         * @param callable[TPurity] $callback
         * @psalm-pure
         */
        public function __construct(callable $callback) {}

        /**
         * @psalm-pure
         * @psalm-purity-from-template TPurity
         */
        public function start(mixed ...$args): mixed {}

        /**
         * @psalm-pure
         * @psalm-purity-from-template TPurity
         */
        public function resume(mixed $value = null): mixed {}

        /**
         * @psalm-pure
         * @psalm-purity-from-template TPurity
         */
        public function throw(Throwable $exception): mixed {}

        /** @psalm-pure */
        public function getReturn(): mixed {}

        /** @psalm-pure */
        public function isStarted(): bool {}

        /** @psalm-pure */
        public function isSuspended(): bool {}

        /** @psalm-pure */
        public function isRunning(): bool {}

        /** @psalm-pure */
        public function isTerminated(): bool {}

        /**
         * The fiber running the caller, which stays the same for the whole call.
         *
         * @psalm-pure
         */
        public static function getCurrent(): ?Fiber {}

        /**
         * Hands control back to whoever started or resumed the current fiber, like `yield`: what
         * that code does until it resumes this fiber is its own effect.
         *
         * @psalm-pure
         */
        public static function suspend(mixed $value = null): mixed {}
    }

    /**
     * @psalm-immutable
     * @template TValue
     *
     * @since 8.2
     */
    final class SensitiveParameterValue
    {
        /** @param TValue $value */
        public function __construct(private mixed $value) {}

        /** @return array<never, never> */
        public function __debugInfo(): array {}

        /** @return TValue */
        public function getValue(): mixed {}
    }

    /**
     * Indicates that the return value of a function should not be ignored.
     * When applied to a function or method, a warning is emitted if the
     * return value is not used.
     *
     * @psalm-immutable
     * @since 8.5
     */
    #[\Attribute(\Attribute::TARGET_METHOD | \Attribute::TARGET_FUNCTION)]
    final class NoDiscard
    {
        public ?string $message;

        public function __construct(?string $message = null) {}
    }

    /**
     * Defers the target validation of internal attributes on the same element to runtime.
     *
     * @psalm-immutable
     * @since 8.5
     */
    #[\Attribute(\Attribute::TARGET_ALL)]
    final class DelayedTargetValidation
    {
    }

    /**
     * Persistent cURL share handle resource.
     *
     * @since 8.5
     */
    final class CurlSharePersistentHandle
    {
    }

    /**
     * @since 8.6
     */
    final class StreamPollHandle implements Io\Poll\Handle
    {
        /** @param resource $stream */
        public function __construct($stream) {}

        /** @return resource */
        public function getStream() {}

        public function isValid(): bool {}
    }
}

namespace Time {
    /** @since 8.6 */
    class TimeException extends \Exception {}

    /**
     * @psalm-immutable
     * @since 8.6
     */
    final class Duration
    {
        public int $seconds;

        public int $nanoseconds;

        public bool $negative;

        private function __construct() {}

        public function __unserialize(array $data): void {}

        /** @psalm-pure */
        public static function fromSeconds(int $seconds, int $nanoseconds = 0): Duration {}

        /** @psalm-pure */
        public static function fromNanoseconds(int $nanoseconds): Duration {}

        /** @psalm-pure */
        public static function fromMicroseconds(int $microseconds): Duration {}

        /** @psalm-pure */
        public static function fromMilliseconds(int $milliseconds): Duration {}

        /** @psalm-pure */
        public static function fromMinutes(int $minutes): Duration {}

        /** @psalm-pure */
        public static function fromHours(int $hours): Duration {}

        /** @psalm-pure */
        public static function fromIso8601DurationString(string $specification): Duration {}

        public function negate(): Duration {}

        public function absolute(): Duration {}

        public function add(Duration $duration): Duration {}

        public function sub(Duration $duration): Duration {}

        public function multiplyBy(int $factor): Duration {}

        public function divideBy(int $divisor): Duration {}

        /** @psalm-pure */
        public static function compare(Duration $a, Duration $b): int {}
    }
}

namespace Io {
    /** @since 8.6 */
    class IoException extends \Exception {}
}

namespace Io\Poll {
    /** @since 8.6 */
    interface Handle {}

    /** @since 8.6 */
    final class Watcher
    {
        final private function __construct() {}

        public function getHandle(): Handle {}

        /** @return list<Event> */
        public function getWatchedEvents(): array {}

        /** @return list<Event> */
        public function getTriggeredEvents(): array {}

        public function getData(): mixed {}

        public function hasTriggered(Event $event): bool {}

        public function isActive(): bool {}

        public function modify(array $events, mixed $data = null): void {}

        public function modifyEvents(array $events): void {}

        public function modifyData(mixed $data): void {}

        public function remove(): void {}
    }

    /** @since 8.6 */
    final class Context
    {
        public function __construct(Backend $backend = Backend::Auto) {}

        public function add(Handle $handle, array $events, mixed $data = null): Watcher {}

        /** @return list<Watcher> */
        public function wait(?\Time\Duration $timeout = null, ?int $maxEvents = null): array {}

        public function getBackend(): Backend {}
    }

    /** @since 8.6 */
    class PollException extends \Io\IoException {}

    /** @since 8.6 */
    abstract class FailedPollOperationException extends PollException
    {
        public const ERROR_NONE = 0;
        public const ERROR_SYSTEM = 1;
        public const ERROR_NOMEM = 2;
        public const ERROR_INVALID = 3;
        public const ERROR_EXISTS = 4;
        public const ERROR_NOTFOUND = 5;
        public const ERROR_TIMEOUT = 6;
        public const ERROR_INTERRUPTED = 7;
        public const ERROR_PERMISSION = 8;
        public const ERROR_TOOBIG = 9;
        public const ERROR_AGAIN = 10;
        public const ERROR_NOSUPPORT = 11;
    }

    /** @since 8.6 */
    class FailedContextInitializationException extends FailedPollOperationException {}

    /** @since 8.6 */
    class FailedHandleAddException extends FailedPollOperationException {}

    /** @since 8.6 */
    class FailedWatcherModificationException extends FailedPollOperationException {}

    /** @since 8.6 */
    class FailedPollWaitException extends FailedPollOperationException {}

    /** @since 8.6 */
    class BackendUnavailableException extends PollException {}

    /** @since 8.6 */
    class InactiveWatcherException extends PollException {}

    /** @since 8.6 */
    class HandleAlreadyWatchedException extends PollException {}

    /** @since 8.6 */
    class InvalidHandleException extends PollException {}
}

namespace {
    /**
     * @psalm-immutable
     * @since 8.6
     */
    final class StreamError
    {
        public StreamErrorCode $code;

        public string $message;

        public string $wrapperName;

        public int $severity;

        public bool $terminating;
    }

    /** @since 8.6 */
    class StreamException extends Exception
    {
        /** @var array<int, StreamError> */
        private array $errors = [];

        /** @return array<int, StreamError> */
        public function getErrors(): array {}
    }

    /** @since 8.6 */
    final class IntlNumberRangeFormatter
    {
        public const COLLAPSE_AUTO = 0;
        public const COLLAPSE_NONE = 1;
        public const COLLAPSE_UNIT = 2;
        public const COLLAPSE_ALL = 3;
        public const IDENTITY_FALLBACK_SINGLE_VALUE = 0;
        public const IDENTITY_FALLBACK_APPROXIMATELY_OR_SINGLE_VALUE = 1;
        public const IDENTITY_FALLBACK_APPROXIMATELY = 2;
        public const IDENTITY_FALLBACK_RANGE = 3;

        private function __construct() {}

        public static function createFromSkeleton(
            string $skeleton,
            string $locale,
            int $collapse,
            int $identityFallback
        ): IntlNumberRangeFormatter {}

        public function format(float|int $start, float|int $end): string {}

        public function getErrorCode(): int {}

        public function getErrorMessage(): string {}
    }
}

namespace Uri\Rfc3986 {
    /** @since 8.6 */
    final class UriBuilder
    {
        private ?string $scheme = null;

        private ?string $userinfo = null;

        private ?string $host = null;

        private ?int $port = null;

        private string $path = "";

        private ?string $query = null;

        private ?string $fragment = null;

        public function reset(): static {}

        public function setScheme(?string $scheme): static {}

        public function setUserInfo(#[\SensitiveParameter] ?string $userInfo): static {}

        public function setHost(?string $host): static {}

        public function setPort(?int $port): static {}

        public function setPath(string $path): static {}

        public function setQuery(?string $query): static {}

        public function setFragment(?string $fragment): static {}

        public function build(?\Uri\Rfc3986\Uri $baseUrl = null): \Uri\Rfc3986\Uri {}
    }
}

namespace Uri\WhatWg {
    /** @since 8.6 */
    final class UrlBuilder
    {
        private string $scheme = "";

        private ?string $username = null;

        private ?string $password = null;

        private ?string $host = null;

        private ?int $port = null;

        private string $path = "";

        private ?string $query = null;

        private ?string $fragment = null;

        public function reset(): static {}

        public function setScheme(string $scheme): static {}

        public function setUsername(?string $username): static {}

        public function setPassword(#[\SensitiveParameter] ?string $password): static {}

        public function setHost(?string $host): static {}

        public function setPort(?int $port): static {}

        public function setPath(string $path): static {}

        public function setQuery(?string $query): static {}

        public function setFragment(?string $fragment): static {}

        /** @param array $softErrors */
        public function build(?\Uri\WhatWg\Url $baseUrl = null, &$softErrors = null): \Uri\WhatWg\Url {}
    }
}

namespace Openssl {
    /** @since 8.6 */
    class OpensslException extends \Exception {}

    /**
